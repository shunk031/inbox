{
  "name": "inbox-codex",
  "private": true,
  "type": "module",
  "description": "Builds the inbox Codex plugin in ./plugin from ./src and the mod's shared modules in ../hooks",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev",
    "test": "node build.mjs --tests && node --test \"test-dist/*.spec.mjs\"",
    "types": "tsc --noEmit -p .",
    "check": "node build.mjs --check"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "jsdom": "^29.1.1",
    "preact": "10.29.8",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.3"
  }
}
